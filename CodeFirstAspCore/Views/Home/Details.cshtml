@model CodeFirstAspCore.Models.Student

@{
    ViewData["Title"] = "Details";
}

<h1>Student Details</h1>

<table class="table table-dark table-bordered table-hover table-striped">

    <thead class="table-dark">
        <tr>
            <th>Field</th>
            <th>Value</th>
        </tr>
    </thead>

    <tbody>

        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <td>@Html.DisplayFor(model => model.Name)</td>
        </tr>

        <tr>
            <th>@Html.DisplayNameFor(model => model.Gender)</th>
            <td>@Html.DisplayFor(model => model.Gender)</td>
        </tr>

        <tr>
            <th>@Html.DisplayNameFor(model => model.Age)</th>
            <td>@Html.DisplayFor(model => model.Age)</td>
        </tr>

        <tr>
            <th>@Html.DisplayNameFor(model => model.Standard)</th>
            <td>@Html.DisplayFor(model => model.Standard)</td>
        </tr>

    </tbody>

</table>

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model?.Id"
       class="btn btn-success">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back To List
    </a>

</div>